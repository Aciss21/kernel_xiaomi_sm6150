
#!/usr/bin/env bash
# ================================================================
#   Kernel Build Script - courbet
#   Toolchain: Gonon Clang 16.0.6
#   By: Aciss
# ================================================================

# ── Project Directory ────────────────────────────────────────────

KERNEL_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$KERNEL_DIR" || exit 1

# ── Telegram Config ──────────────────────────────────────────────

TG_TOKEN="${TG_TOKEN:-${GITHUB_TG_TOKEN:-}}"
TG_CHAT_ID="${TG_CHAT_ID:-${GITHUB_TG_CHAT_ID:-}}"

if [ -z "$TG_TOKEN" ] || [ -z "$TG_CHAT_ID" ]; then
    echo "Telegram configuration missing!"
    exit 1
fi

# ── Build Config ─────────────────────────────────────────────────

DEVICE="courbet"
DEVICE_NAME="Xiaomi Mi 11 Lite 4G"
KNAME="shirayuki"
VAR="aosp"

ROOT="KSU"
KERNEL_BASE=""

ZIPNAME="${KNAME}-${VAR}-${ROOT}.zip"

ANYKERNEL_REPO="https://github.com/Aciss21/AnyKernel3.git"
ANYKERNEL_BRANCH="master"

DEFCONFIG="vendor/courbet_defconfig"

# ── Toolchain Config ─────────────────────────────────────────────

CLANG_DIR="$KERNEL_DIR/clang"
CLANG_URL="https://github.com/Gonon-Kernel/gonon-clang/releases/download/16.0.6-20231104-release/GononClang-16.0.6-20231104.tar.xz"
CLANG_ARCHIVE="$KERNEL_DIR/GononClang.tar.xz"

export ARCH=arm64
export SUBARCH=arm64

export CC=clang
export CROSS_COMPILE=aarch64-linux-gnu-
export CROSS_COMPILE_ARM32=arm-linux-gnueabi-

export AR=llvm-ar
export NM=llvm-nm
export OBJCOPY=llvm-objcopy
export OBJDUMP=llvm-objdump
export STRIP=llvm-strip

# ── Output Paths ─────────────────────────────────────────────────

OUT="$KERNEL_DIR/out"

KERNEL="$OUT/arch/arm64/boot/Image.gz"
DTBO="$OUT/arch/arm64/boot/dtbo.img"
DTB="$OUT/arch/arm64/boot/dtb.img"

BUILD_LOG="$KERNEL_DIR/build.log"

# ── Build Exports ────────────────────────────────────────────────

export KBUILD_BUILD_USER="Aciss"
export KBUILD_BUILD_HOST="Szes-Labs"

SECONDS=0

# ── Build Info ───────────────────────────────────────────────────

DOCKER_OS="$(grep -oP '(?<=^PRETTY_NAME=").*(?=")' /etc/os-release 2>/dev/null)"
DOCKER_OS="${DOCKER_OS:-$(uname -sr)}"

DATE="$(TZ=Asia/Jakarta date +"%-d %B %Y, %H:%M WIB")"

KERNEL_VERSION="$(make -s -C "$KERNEL_DIR" kernelversion 2>/dev/null)"
KERNEL_VERSION="${KERNEL_VERSION:-Unknown}"

# ── Telegram Functions ───────────────────────────────────────────

build_time() {
    echo "$((SECONDS / 60)) minutes $((SECONDS % 60)) seconds"
}

tg_send() {
    curl -fsS --max-time 20 -X POST \
        "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
        -d "chat_id=${TG_CHAT_ID}" \
        --data-urlencode "text=$1" \
        > /dev/null || true
}

tg_send_file() {
    local file="$1"
    local caption="$2"

    [ -f "$file" ] || return 1

    curl -fsS --max-time 300 \
        -F "document=@$file" \
        -F "chat_id=$TG_CHAT_ID" \
        --form-string "caption=$caption" \
        "https://api.telegram.org/bot${TG_TOKEN}/sendDocument" \
        > /dev/null || true
}

tg_fail() {
    local reason="$1"
    local logfile="${2:-}"
    local msg

    msg="❌ Build Failed!

Reason: $reason
Build took: $(build_time)"

    echo
    echo "Build failed: $reason"

    if [ -n "$logfile" ] && [ -f "$logfile" ]; then
        tg_send_file "$logfile" "$msg"
    else
        tg_send "$msg"
    fi

    exit 1
}

# ── Header ───────────────────────────────────────────────────────

echo "================================================"
echo "       KUDA ASELI NAIL KUDA BESI"
echo "================================================"
echo " Device  : $DEVICE"
echo " Kernel  : $KNAME"
echo " Variant : $VAR"
echo " Builder : $KBUILD_BUILD_USER@$KBUILD_BUILD_HOST"
echo " Output  : $ZIPNAME"
echo "================================================"

# ── Toolchain: Gonon Clang ───────────────────────────────────────

echo
echo "Checking Gonon Clang 16.0.6..."

if [ ! -x "$CLANG_DIR/bin/clang" ]; then
    echo "Downloading Gonon Clang 16.0.6..."

    mkdir -p "$CLANG_DIR" ||
        tg_fail "Cannot create clang directory"

    curl -fL --retry 3 --connect-timeout 20 \
        "$CLANG_URL" \
        -o "$CLANG_ARCHIVE" ||
        tg_fail "Gonon Clang download failed"

    echo "Extracting Gonon Clang..."

    tar -xJf "$CLANG_ARCHIVE" -C "$CLANG_DIR" ||
        tg_fail "Gonon Clang extraction failed"

    rm -f "$CLANG_ARCHIVE"
fi

if [ ! -x "$CLANG_DIR/bin/clang" ]; then
    tg_fail "clang binary not found at $CLANG_DIR/bin/clang; check archive structure"
fi

export PATH="$CLANG_DIR/bin:$PATH"

if ! command -v clang >/dev/null 2>&1; then
    tg_fail "clang is unavailable in PATH"
fi

if ! command -v ld.lld >/dev/null 2>&1; then
    tg_fail "ld.lld is unavailable in PATH"
fi

CLANG_VERSION="$(clang --version | head -n1)"
LINKER_VERSION="$(ld.lld --version | head -n1)"

# ── Telegram: Build Triggered ────────────────────────────────────

tg_send "🔨 Kernel Build Triggered

Docker OS: $DOCKER_OS
Date: $DATE
Device: $DEVICE_NAME
Codename: $DEVICE
Kernel Version: $KERNEL_VERSION
Root: $ROOT
Compiler: Gonon $CLANG_VERSION"

# ── Step 1: Clean ────────────────────────────────────────────────

if [[ "${1:-}" == "-c" || "${1:-}" == "--clean" ]]; then
    echo "[1/4] Cleaning output..."
    rm -rf "$OUT" || tg_fail "Failed to clean output directory"
fi

# ── Step 2: Defconfig ────────────────────────────────────────────

echo
echo "[2/4] Loading defconfig..."
echo "Working directory: $KERNEL_DIR"
echo "Defconfig: arch/arm64/configs/$DEFCONFIG"

make O="$OUT" \
    ARCH=arm64 \
    CC=clang \
    CROSS_COMPILE=aarch64-linux-gnu- \
    CROSS_COMPILE_ARM32=arm-linux-gnueabi- \
    AR=llvm-ar \
    NM=llvm-nm \
    OBJCOPY=llvm-objcopy \
    OBJDUMP=llvm-objdump \
    STRIP=llvm-strip \
    "$DEFCONFIG"

DEFCONFIG_STATUS=$?

if [ "$DEFCONFIG_STATUS" -ne 0 ]; then
    tg_fail "Defconfig failed"
fi

echo "Defconfig loaded successfully."

# ── Step 3: Compile ──────────────────────────────────────────────

echo
echo "[3/4] Compiling kernel..."

THREADS="$(nproc --all)"
rm -f "$BUILD_LOG"

make -j"$THREADS" \
    O="$OUT" \
    ARCH=arm64 \
    CC=clang \
    CROSS_COMPILE=aarch64-linux-gnu- \
    CROSS_COMPILE_ARM32=arm-linux-gnueabi- \
    AR=llvm-ar \
    NM=llvm-nm \
    OBJCOPY=llvm-objcopy \
    OBJDUMP=llvm-objdump \
    STRIP=llvm-strip \
    2>&1 | tee "$BUILD_LOG"

BUILD_STATUS=${PIPESTATUS[0]}

if [ "$BUILD_STATUS" -ne 0 ] || [ ! -f "$KERNEL" ]; then
    tg_fail "Kernel compilation failed" "$BUILD_LOG"
fi

echo
echo "Kernel compiled successfully."
echo "Image: $KERNEL"

# ── Step 4: Package AnyKernel3 ───────────────────────────────────

echo
echo "[4/4] Packaging AnyKernel3..."

rm -rf "$KERNEL_DIR/AnyKernel3"

git clone -q \
    --depth=1 \
    -b "$ANYKERNEL_BRANCH" \
    "$ANYKERNEL_REPO" \
    "$KERNEL_DIR/AnyKernel3"

AK_STATUS=$?

if [ "$AK_STATUS" -ne 0 ]; then
    tg_fail "AnyKernel3 clone failed"
fi

AK_DIR="$KERNEL_DIR/AnyKernel3"

# ── Configure Device ─────────────────────────────────────────────

if [ ! -f "$AK_DIR/anykernel.sh" ]; then
    tg_fail "AnyKernel3 anykernel.sh not found"
fi

sed -i \
    's/device\.name1=.*/device.name1=courbet/' \
    "$AK_DIR/anykernel.sh"

sed -i \
    's/device\.name2=.*/device.name2=courbetin/' \
    "$AK_DIR/anykernel.sh"

# ── Copy Kernel ──────────────────────────────────────────────────

cp "$KERNEL" "$AK_DIR/" ||
    tg_fail "Failed to copy kernel image"

# ── Copy DTBO ────────────────────────────────────────────────────

if [ -f "$DTBO" ]; then
    cp "$DTBO" "$AK_DIR/" ||
        tg_fail "Failed to copy DTBO"
else
    echo "Warning: DTBO image not found; skipping."
fi

# ── Copy DTB ─────────────────────────────────────────────────────

if [ -f "$DTB" ]; then
    cp "$DTB" "$AK_DIR/" ||
        tg_fail "Failed to copy DTB"
else
    echo "Warning: DTB image not found; skipping."
fi

# ── Create ZIP ───────────────────────────────────────────────────

cd "$AK_DIR" ||
    tg_fail "Cannot enter AnyKernel3 directory"

rm -f "$KERNEL_DIR/$ZIPNAME"

zip -r9 "$KERNEL_DIR/$ZIPNAME" \
    . \
    -x "*.git*" \
    -x "*.github*" \
    > /dev/null

ZIP_STATUS=$?

cd "$KERNEL_DIR" || exit 1

if [ "$ZIP_STATUS" -ne 0 ] || [ ! -s "$KERNEL_DIR/$ZIPNAME" ]; then
    tg_fail "ZIP creation failed"
fi

rm -rf "$AK_DIR"

# ── Upload ───────────────────────────────────────────────────────

DURATION="$(build_time)"
ZIP_MD5="$(md5sum "$KERNEL_DIR/$ZIPNAME" | cut -d' ' -f1)"

echo
echo "Build completed."
echo "Duration: $DURATION"

FINISH_MSG="✅ Build Finished!

Build took: $DURATION
MD5: $ZIP_MD5"

if [ -n "$KERNEL_BASE" ]; then
    FINISH_MSG="$FINISH_MSG
This kernel is based on $KERNEL_BASE kernel!"
fi

tg_send_file "$KERNEL_DIR/$ZIPNAME" "$FINISH_MSG"

# ── Done ─────────────────────────────────────────────────────────

echo
echo "================================================"
echo " Build Complete"
echo "================================================"
echo " Device   : $DEVICE"
echo " Kernel   : $KNAME"
echo " Variant  : $VAR"
echo " Compiler : $CLANG_VERSION"
echo " Output   : $ZIPNAME"
echo " Duration : $DURATION"
echo " MD5      : $ZIP_MD5"
echo "================================================"
